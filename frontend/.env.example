# Copia este archivo como .env.local para desarrollo.
# Sin las variables de Cloudflare, el API usa un SQLite local en .data/ con las mismas migraciones de D1.

# Cloudflare D1 (producción, o para probar contra la base real desde tu máquina)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_D1_DATABASE_ID=
CLOUDFLARE_API_TOKEN=

# Firma de las sesiones. En producción: una cadena aleatoria de 32+ caracteres.
JWT_SECRET=
